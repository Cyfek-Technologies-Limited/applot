# Copy to .env.local and replace the placeholders. Never commit credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional locally: leave empty to support the port selected by next dev.
BETTER_AUTH_URL=
# Enables CV profile extraction and the existing AI job matching features.
AI_GATEWAY_API_KEY=
PRIVACY_CONTACT_EMAIL=
# Optional browser service for serverless deployment; local development uses installed Chromium.
APPLICATION_BROWSER_WS_URL=
# Stable secret for AES-GCM encryption of original CV attachments. Keep this unchanged.
# If empty, BETTER_AUTH_SECRET is used.
RESUME_ENCRYPTION_KEY=
# Add employer board slugs (not URLs), comma-separated. Empty disables that provider.
GREENHOUSE_BOARDS=canonical,gitlab
LEVER_BOARDS=
ASHBY_BOARDS=linear,zapier
THE_MUSE_API_KEY=
# Jooble keys are country-specific. For Nigeria, obtain a key at ng.jooble.org/api/about.
JOOBLE_API_KEY=
JOOBLE_COUNTRY=ng
# Protects the scheduled autopilot endpoint. Also configure this in your deployment.
CRON_SECRET=
# For hosted PostgreSQL, use the provider's connection string, including SSL options.
# Optional direct connection for schema operations:
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST:5432/DATABASE
