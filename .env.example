# Copy to .env.local and replace the placeholders. Never commit credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional locally: leave empty to support the port selected by next dev.
BETTER_AUTH_URL=
# For hosted PostgreSQL, use the provider's connection string, including SSL options.
# Optional direct connection for schema operations:
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST:5432/DATABASE
